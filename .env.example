# VCMS configuration — copy to .env and fill in real values.
# All values are optional; the app falls back to safe defaults.
# Never commit the real .env file.

# Flask session secret (set a long random string in production)
VCMS_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database location (defaults to data/vehicles.db)
#VCMS_DATABASE_URI=sqlite:///data/vehicles.db

# Login (defaults: admin / admin123 — change these!)
VCMS_ADMIN_USER=admin
VCMS_ADMIN_PASSWORD=change-me
# Set to false to disable login entirely (trusted LAN only)
VCMS_LOGIN_REQUIRED=true

# AI provider: openrouter | gemini (settings UI overrides this)
VCMS_AI_PROVIDER=openrouter
VCMS_OPENROUTER_KEY=sk-or-v1-your-key-here
VCMS_OPENROUTER_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
VCMS_GOOGLE_KEY=AIza-your-key-here
VCMS_GOOGLE_MODEL=gemini-2.5-flash

# SMTP (settings UI overrides these unless left blank)
VCMS_SMTP_SERVER=smtp.gmail.com
VCMS_SMTP_PORT=587
VCMS_SMTP_USER=you@example.com
VCMS_SMTP_PASSWORD=your-app-password
VCMS_SMTP_FROM=you@example.com

# Hour (0-23) for the daily auto email reminder job
VCMS_EMAIL_REMINDER_HOUR=9

# Google Drive sync master switch
VCMS_GDRIVE_ENABLED=false
