# VCMS Environment Variables
# Copy this file to .env and fill in your values

# Flask
VCMS_SECRET_KEY=your-secret-key-here
VCMS_LOGIN_REQUIRED=true
VCMS_ADMIN_USER=admin
VCMS_ADMIN_PASSWORD=change-me

# AI Provider (openrouter or gemini)
VCMS_AI_PROVIDER=openrouter

# OpenRouter AI
VCMS_OPENROUTER_KEY=your-openrouter-api-key-here
VCMS_OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Google Gemini AI
VCMS_GEMINI_KEY=your-gemini-api-key-here
VCMS_GEMINI_MODEL=gemini-2.0-flash

# Google Drive OAuth2
VCMS_GDRIVE_CLIENT_ID=your-google-client-id
VCMS_GDRIVE_CLIENT_SECRET=your-google-client-secret
VCMS_GDRIVE_REDIRECT_URI=http://localhost:5000/settings/google/callback

# Gmail SMTP Email Reminders
VCMS_SMTP_SERVER=smtp.gmail.com
VCMS_SMTP_PORT=587
VCMS_SMTP_USER=your-email@gmail.com
VCMS_SMTP_PASSWORD=your-16-char-app-password
VCMS_SMTP_FROM=your-email@gmail.com
VCMS_EMAIL_REMINDERS_ENABLED=false
VCMS_EMAIL_REMINDER_HOUR=9
